{
  "type": "control.merge@1",
  "display_name": "Merge",
  "description": "Combines explicitly mapped values from incoming branches.",
  "category": "control",
  "execution_owner": "execution-engine",
  "inputs": [
    {
      "name": "branch_a",
      "direction": "input",
      "required": false,
      "cardinality": "optional",
      "schema": { "type": "object" }
    },
    {
      "name": "branch_b",
      "direction": "input",
      "required": false,
      "cardinality": "optional",
      "schema": { "type": "object" }
    }
  ],
  "outputs": [
    {
      "name": "value",
      "direction": "output",
      "required": true,
      "cardinality": "single",
      "schema": { "type": "object" }
    }
  ],
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["mappings"],
    "properties": {
      "mappings": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_port", "source_path", "target_path"],
          "properties": {
            "source_port": { "type": "string" },
            "source_path": { "type": "string" },
            "target_path": { "type": "string" }
          }
        }
      },
      "on_conflict": {
        "type": "string",
        "enum": ["reject", "first", "last"],
        "default": "reject"
      }
    }
  },
  "credential_slots": [],
  "resource_slots": [],
  "capabilities": {
    "retryable": false,
    "cancellable": true,
    "side_effecting": false,
    "execution_mode": "inline",
    "emits_progress": false,
    "resumable": false
  },
  "ui": {
    "icon": "merge",
    "color_token": "control",
    "inspector": null
  }
}
