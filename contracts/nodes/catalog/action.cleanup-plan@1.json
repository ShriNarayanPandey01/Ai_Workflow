{
  "type": "action.cleanup-plan@1",
  "display_name": "Cleanup Plan",
  "description": "Inventories a typed, scoped set of resources and produces an immutable dry-run cleanup plan.",
  "category": "action",
  "execution_owner": "execution-engine",
  "inputs": [
    {
      "name": "scope",
      "direction": "input",
      "required": true,
      "cardinality": "single",
      "schema": { "type": "object" }
    }
  ],
  "outputs": [
    {
      "name": "plan",
      "direction": "output",
      "required": true,
      "cardinality": "single",
      "schema": {
        "type": "object",
        "required": ["plan_id", "plan_hash", "item_count"],
        "properties": {
          "plan_id": { "type": "string", "format": "uuid" },
          "plan_hash": { "type": "string", "minLength": 1, "maxLength": 256 },
          "item_count": { "type": "integer", "minimum": 0 },
          "estimated_reclaimed_bytes": { "type": ["integer", "null"], "minimum": 0 },
          "warnings": { "type": "array" }
        }
      }
    }
  ],
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["connector_type", "action", "max_items", "max_bytes"],
    "properties": {
      "connector_type": {
        "type": "string",
        "enum": ["dataset", "artifact_collection", "run_data", "external_connector"]
      },
      "action": {
        "type": "string",
        "enum": ["archive", "quarantine", "delete"]
      },
      "min_age_days": {
        "type": ["integer", "null"],
        "minimum": 0,
        "maximum": 36500
      },
      "status_filters": {
        "type": "array",
        "maxItems": 32,
        "items": { "type": "string", "maxLength": 64 }
      },
      "max_items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100000
      },
      "max_bytes": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1099511627776
      },
      "exclusions": {
        "type": "array",
        "maxItems": 1024,
        "items": { "type": "string", "maxLength": 512 }
      }
    }
  },
  "credential_slots": [
    {
      "name": "connector",
      "credential_type": "cleanup_connector",
      "required": false
    }
  ],
  "resource_slots": [
    {
      "name": "scope",
      "resource_type": "other",
      "required": false,
      "description": "Optional typed connector scope."
    }
  ],
  "capabilities": {
    "retryable": false,
    "cancellable": true,
    "side_effecting": false,
    "execution_mode": "durable-task",
    "emits_progress": true,
    "resumable": true
  },
  "ui": {
    "icon": "clipboard",
    "color_token": "action",
    "inspector": "cleanup-plan"
  }
}
