{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-workflow.local/contracts/messages/events/task.lifecycle.schema.json",
  "title": "TaskLifecyclePayloads",
  "$defs": {
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "status", "progress"],
      "properties": {
        "task_id": { "type": "string", "format": "uuid" },
        "status": {
          "type": "string",
          "enum": ["QUEUED", "RUNNING", "CANCELLING"]
        },
        "stage": { "type": ["string", "null"], "maxLength": 128 },
        "progress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "completed", "failed", "skipped", "percent"],
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "completed": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 },
            "skipped": { "type": "integer", "minimum": 0 },
            "percent": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "elapsed_seconds": { "type": "number", "minimum": 0 },
            "provider_calls": { "type": "integer", "minimum": 0 },
            "tokens": { "type": "integer", "minimum": 0 },
            "estimated_cost": { "type": "number", "minimum": 0 }
          }
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string", "maxLength": 512 },
          "maxItems": 50
        }
      }
    },
    "itemCompleted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "item_key", "status"],
      "properties": {
        "task_id": { "type": "string", "format": "uuid" },
        "item_key": { "type": "string", "minLength": 1, "maxLength": 256 },
        "status": {
          "type": "string",
          "enum": ["SUCCEEDED", "FAILED", "SKIPPED"]
        },
        "attempt": { "type": "integer", "minimum": 1 },
        "result_summary": { "type": ["object", "null"] },
        "error_summary": { "type": ["object", "null"] }
      }
    },
    "completed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "status"],
      "properties": {
        "task_id": { "type": "string", "format": "uuid" },
        "status": { "const": "SUCCEEDED" },
        "result": { "type": "object" },
        "artifact_refs": {
          "type": "array",
          "items": { "type": "string", "format": "uuid" }
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 50
        },
        "usage": { "type": "object" }
      }
    },
    "failed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "status", "error"],
      "properties": {
        "task_id": { "type": "string", "format": "uuid" },
        "status": {
          "type": "string",
          "enum": ["FAILED", "CANCELLED", "TIMED_OUT"]
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" }
          }
        },
        "partial_progress": { "type": ["object", "null"] }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/progress" },
    { "$ref": "#/$defs/itemCompleted" },
    { "$ref": "#/$defs/completed" },
    { "$ref": "#/$defs/failed" }
  ]
}
