{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-workflow.local/contracts/messages/events/node.lifecycle.schema.json",
  "title": "NodeLifecyclePayloads",
  "description": "Payload shapes for node.started, node.completed, and node.failed.",
  "$defs": {
    "redactedJson": {
      "type": "object"
    },
    "errorInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "message": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "retryable": { "type": "boolean" }
      }
    },
    "tokenUsage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prompt_tokens": { "type": "integer", "minimum": 0 },
        "completion_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 }
      }
    },
    "nodeStarted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "node_type", "attempt", "status"],
      "properties": {
        "node_id": { "type": "string", "format": "uuid" },
        "node_type": { "type": "string" },
        "attempt": { "type": "integer", "minimum": 1 },
        "status": { "const": "RUNNING" },
        "started_at": { "type": "string", "format": "date-time" }
      }
    },
    "nodeCompleted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "node_type", "attempt", "status"],
      "properties": {
        "node_id": { "type": "string", "format": "uuid" },
        "node_type": { "type": "string" },
        "attempt": { "type": "integer", "minimum": 1 },
        "status": { "const": "SUCCEEDED" },
        "inputs": { "$ref": "#/$defs/redactedJson" },
        "outputs": { "$ref": "#/$defs/redactedJson" },
        "token_usage": { "$ref": "#/$defs/tokenUsage" },
        "estimated_cost": { "type": ["number", "null"], "minimum": 0 },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "finished_at": { "type": "string", "format": "date-time" },
        "artifact_refs": {
          "type": "array",
          "items": { "type": "string", "format": "uuid" }
        }
      }
    },
    "nodeFailed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "node_type", "attempt", "status", "error"],
      "properties": {
        "node_id": { "type": "string", "format": "uuid" },
        "node_type": { "type": "string" },
        "attempt": { "type": "integer", "minimum": 1 },
        "status": { "const": "FAILED" },
        "inputs": { "$ref": "#/$defs/redactedJson" },
        "error": { "$ref": "#/$defs/errorInfo" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "finished_at": { "type": "string", "format": "date-time" }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/nodeStarted" },
    { "$ref": "#/$defs/nodeCompleted" },
    { "$ref": "#/$defs/nodeFailed" }
  ]
}
