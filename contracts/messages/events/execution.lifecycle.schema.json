{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-workflow.local/contracts/messages/events/execution.lifecycle.schema.json",
  "title": "ExecutionLifecyclePayloads",
  "description": "Payload shapes for execution.* lifecycle events. Envelope sequence is required for these events.",
  "$defs": {
    "redactedJson": {
      "type": "object",
      "description": "Redacted JSON object safe for persistence and SSE."
    },
    "errorInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "message": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "retryable": { "type": "boolean" }
      }
    },
    "tokenUsage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prompt_tokens": { "type": "integer", "minimum": 0 },
        "completion_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 }
      }
    },
    "executionQueued": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "const": "QUEUED" },
        "mode": { "type": "string", "enum": ["draft", "published"] }
      }
    },
    "executionStarted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "const": "RUNNING" },
        "started_at": { "type": "string", "format": "date-time" }
      }
    },
    "executionWaiting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "waiting_reason", "interrupt_id"],
      "properties": {
        "status": { "const": "WAITING" },
        "waiting_reason": { "type": "string", "enum": ["HUMAN", "TASK"] },
        "interrupt_id": { "type": "string", "format": "uuid" },
        "approval_id": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "format": "uuid" }
          ]
        },
        "node_id": { "type": "string", "format": "uuid" },
        "approval_request": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["request_payload", "allowed_response_schema"],
              "properties": {
                "request_payload": { "$ref": "#/$defs/redactedJson" },
                "allowed_response_schema": { "type": "object" }
              }
            }
          ]
        },
        "task_ref": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["task_id", "task_type"],
              "properties": {
                "task_id": { "type": "string", "format": "uuid" },
                "task_type": { "type": "string" }
              }
            }
          ]
        }
      }
    },
    "executionCompleted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "const": "SUCCEEDED" },
        "outputs": { "$ref": "#/$defs/redactedJson" },
        "token_usage": { "$ref": "#/$defs/tokenUsage" },
        "estimated_cost": { "type": ["number", "null"], "minimum": 0 },
        "finished_at": { "type": "string", "format": "date-time" }
      }
    },
    "executionFailed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "error"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["FAILED", "TIMED_OUT"]
        },
        "error": { "$ref": "#/$defs/errorInfo" },
        "finished_at": { "type": "string", "format": "date-time" }
      }
    },
    "executionCancelled": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "const": "CANCELLED" },
        "reason": {
          "type": "string",
          "enum": ["user_requested", "timeout", "system", "parent_cancelled"]
        },
        "finished_at": { "type": "string", "format": "date-time" }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/executionQueued" },
    { "$ref": "#/$defs/executionStarted" },
    { "$ref": "#/$defs/executionWaiting" },
    { "$ref": "#/$defs/executionCompleted" },
    { "$ref": "#/$defs/executionFailed" },
    { "$ref": "#/$defs/executionCancelled" }
  ]
}
