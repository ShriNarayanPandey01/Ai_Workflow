{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-workflow.local/contracts/messages/commands/execution.cancel.schema.json",
  "title": "ExecutionCancelPayload",
  "type": "object",
  "additionalProperties": false,
  "required": ["reason"],
  "properties": {
    "reason": {
      "type": "string",
      "enum": ["user_requested", "timeout", "system", "parent_cancelled"]
    },
    "requested_by": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "format": "uuid" }
      ]
    }
  }
}
