{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-workflow.local/contracts/messages/commands/document.ingest.schema.json",
  "title": "DocumentIngestPayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_id",
    "document_id",
    "object_key",
    "content_hash",
    "media_type",
    "size_bytes",
    "version"
  ],
  "properties": {
    "dataset_id": { "type": "string", "format": "uuid" },
    "document_id": { "type": "string", "format": "uuid" },
    "object_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 hex of object bytes."
    },
    "media_type": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 104857600
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "original_name": {
      "type": ["string", "null"],
      "maxLength": 512
    },
    "embedding_config": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
