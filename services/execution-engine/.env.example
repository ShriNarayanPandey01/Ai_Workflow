# Safe placeholders only. Do not commit real provider keys.
AIW_DATABASE_URL=postgresql://aiw:aiw@postgres:5432/aiw
AIW_RABBITMQ_URL=amqp://aiw:aiw@rabbitmq:5672/
AIW_SERVICE_ROLE=execution-worker
AIW_LOG_LEVEL=INFO
AIW_SCHEMA_PATH=/app/sql/001_init.sql

# Local test switches. Keep true for offline smoke tests.
AIW_FAKE_LLM=true
AIW_FAKE_IMAGE=true

# Baseten Muse Spark Open provider for ai.chat-model@1.
BASETEN_API_KEY=
AIW_CHAT_BASE_URL=https://inference.baseten.co/v1
AIW_CHAT_MODEL=meta-models/muse-spark-open-1026

# Gemini embeddings for RAG ingestion and retrieval.
GEMINI_API_KEY=
AIW_EMBEDDING_MODEL=gemini-embedding-001
AIW_EMBEDDING_DIMENSIONS=1536
AIW_OPENAI_IMAGE_MODEL=gpt-image-1

# DeepSeek provider for ai.llm@1 through Zenmux. ZENMUSK_API_KEY is also accepted for compatibility.
ZENMUX_API_KEY=
ZENMUSK_API_KEY=
AIW_DEEPSEEK_API_KEY=
AIW_DEEPSEEK_BASE_URL=https://zenmux.ai/api/v1
AIW_DEEPSEEK_MODEL=deepseek/deepseek-v4-pro

# Gemini text provider for ai.llm@1 uses GEMINI_API_KEY above.
GOOGLE_API_KEY=
AIW_GEMINI_TEXT_MODEL=gemini-3.5-flash

# Claude provider for ai.llm@1.
ANTHROPIC_API_KEY=
AIW_ANTHROPIC_API_KEY=
AIW_ANTHROPIC_BASE_URL=https://api.anthropic.com
AIW_ANTHROPIC_MODEL=claude-sonnet-4-5

# Image generation for image.generate@1. Provider can be gemini, openai, or zenmusk.
AIW_IMAGE_PROVIDER=gemini
AIW_GOOGLE_IMAGE_MODEL=gemini-3.1-flash-lite-image
AIW_ZENMUSK_IMAGE_MODEL=google/gemini-3.1-flash-image
AIW_ZENMUSK_IMAGE_BASE_URL=https://zenmux.ai/api/vertex-ai
AIW_ARTIFACT_DIR=/app/artifacts

# Control-plane simulator defaults.
AIW_FIXTURE_PATH=
AIW_SIM_WORKFLOW=passthrough
AIW_IMAGE_PROMPT=
AIW_IMAGE_LLM_PROVIDER=deepseek
AIW_IMAGE_LLM_MODEL=deepseek/deepseek-v4-pro
AIW_IMAGE_MODEL=
AIW_SIM_TIMEOUT=180

# Runtime bounds.
AIW_MAX_GRAPH_NODES=500
AIW_MAX_LOOP_ITERATIONS=100
AIW_MAX_RUN_SECONDS=300
AIW_MAX_PAYLOAD_BYTES=1048576
