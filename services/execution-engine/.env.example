# Safe placeholders only. Do not commit real provider keys.
AIW_DATABASE_URL=postgresql://aiw:aiw@postgres:5432/aiw
AIW_RABBITMQ_URL=amqp://aiw:aiw@rabbitmq:5672/
AIW_SERVICE_ROLE=execution-worker
AIW_LOG_LEVEL=INFO
AIW_SCHEMA_PATH=/app/sql/001_init.sql

# Local test switches. Keep true for offline smoke tests.
AIW_FAKE_LLM=true
AIW_FAKE_IMAGE=true

# OpenAI chat is available with OPENAI_API_KEY and AIW_CHAT_ROUTING_PROVIDER=openai.
# The defaults below retain ZenMux; ZENMUSK_API_KEY is its accepted key alias.
OPENAI_API_KEY=
ZENMUX_API_KEY=
ZENMUSK_API_KEY=
AIW_DEEPSEEK_API_KEY=
AIW_CHAT_BASE_URL=https://zenmux.ai/api/v1
# Optional ZenMux routing provider slug; zenmux uses automatic routing.
AIW_CHAT_ROUTING_PROVIDER=zenmux
AIW_CHAT_MODEL=deepseek/deepseek-v4-pro

# Gemini embeddings for RAG ingestion and retrieval.
GEMINI_API_KEY=
AIW_EMBEDDING_MODEL=gemini-embedding-001
AIW_EMBEDDING_DIMENSIONS=1536

# Gemini text provider for ai.llm@1 uses GEMINI_API_KEY above.
GOOGLE_API_KEY=
AIW_GEMINI_TEXT_MODEL=gemini-3.5-flash

# Claude provider for ai.llm@1.
ANTHROPIC_API_KEY=
AIW_ANTHROPIC_API_KEY=
AIW_ANTHROPIC_BASE_URL=https://api.anthropic.com
AIW_ANTHROPIC_MODEL=claude-sonnet-4-5


# DeepSeek provider for ai.llm@1. Zenmusk keys can be passed as ZENMUSK_API_KEY.
AIW_DEEPSEEK_API_KEY=
AIW_DEEPSEEK_BASE_URL=https://api.deepseek.com
AIW_DEEPSEEK_MODEL=deepseek-v4-pro
AIW_DEEPSEEK_IMAGE_BASE_URL=https://api.deepseek.com/v1
AIW_DEEPSEEK_IMAGE_MODEL=deepseek-image


AIW_ARTIFACT_DIR=/app/artifacts

# Control-plane simulator defaults.
AIW_FIXTURE_PATH=
AIW_SIM_WORKFLOW=passthrough
AIW_IMAGE_PROMPT=
# Reserved for image generation; no execution-engine consumer is wired up yet.
AIW_IMAGE_GENERATION_MODEL=
AIW_SIM_TIMEOUT=180

# Runtime bounds.
AIW_MAX_GRAPH_NODES=500
AIW_MAX_LOOP_ITERATIONS=100
AIW_MAX_RUN_SECONDS=300
AIW_MAX_PAYLOAD_BYTES=1048576
