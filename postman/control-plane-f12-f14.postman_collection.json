{
  "info": {
    "name": "AI Workflow Control Plane F12-F14",
    "description": "Setup then datasets/documents, task list/cancel, artifact download 404, health/readiness. Import the Local environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = `user+${Date.now()}@example.com`;",
                  "pm.environment.set('email', email);",
                  "pm.environment.set('password', 'password1');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('created', () => pm.response.to.have.status(201));",
                  "pm.environment.set('accessToken', pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"displayName\": \"Ada Lovelace\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "Create project",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('created', () => pm.response.to.have.status(201));",
                  "pm.environment.set('projectId', pm.response.json().projectId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"F12-F14\"\n}" },
            "url": "{{baseUrl}}/api/v1/projects"
          }
        }
      ]
    },
    {
      "name": "Datasets",
      "item": [
        {
          "name": "Create dataset",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('created', () => pm.response.to.have.status(201));",
                  "pm.environment.set('datasetId', pm.response.json().datasetId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"kb\"\n}" },
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/datasets"
          }
        },
        {
          "name": "List datasets",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/datasets"
          }
        },
        {
          "name": "Create upload intent",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('created', () => pm.response.to.have.status(201));",
                  "pm.environment.set('documentId', pm.response.json().documentId);",
                  "pm.environment.set('objectKey', pm.response.json().objectKey);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"originalName\": \"notes.txt\",\n  \"mediaType\": \"text/plain\",\n  \"sizeBytes\": 12\n}"
            },
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/datasets/{{datasetId}}/documents/uploads"
          }
        },
        {
          "name": "Confirm ingest",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documentId\": \"{{documentId}}\",\n  \"contentHash\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/datasets/{{datasetId}}/documents"
          }
        },
        {
          "name": "List documents",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/datasets/{{datasetId}}/documents"
          }
        }
      ]
    },
    {
      "name": "Tasks and artifacts",
      "item": [
        {
          "name": "List tasks for run",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/executions/{{runId}}/tasks"
          }
        },
        {
          "name": "Cancel task",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/tasks/{{taskId}}/cancel"
          }
        },
        {
          "name": "Artifact download 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('missing artifact', () => pm.response.to.have.status(404));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/artifacts/00000000-0000-4000-8000-000000000001/download"
          }
        }
      ]
    },
    {
      "name": "Observability",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('up', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/actuator/health"
          }
        },
        {
          "name": "Readiness",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('ready', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/actuator/health/readiness"
          }
        }
      ]
    }
  ]
}
